{
  "in": "workspace/input.jar",
  "out": "workspace/output.jar",
  "libs": "workspace/libs/",
  "dictionary": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_",
  "computeFrames": true,
  "watermark": "",
  "aggressiveOverload": true,
  "exclusionPresets": [
    "api",
    "mc-fabric"
  ],
  "transformers": {
    "trim": {
      "enabled": false,
      "classes": true,
      "fields": true,
      "methods": false
    },
    "renameFields": {
      "enabled": true,
      "preserveRecordNames": true,
      "keepSerializableNames": true,
      "prefix": "",
      "shuffle": true
    },
    "renameMethods": {
      "enabled": true,
      "prefix": "",
      "shuffle": true
    },
    "renameClasses": {
      "enabled": true,
      "prefix": "obf/",
      "mixinPrefix": "mixin.",
      "renameSourceFile": true,
      "randomize": true
    },
    "localNames": {
      "enabled": true
    },
    "lineNumbers": {
      "enabled": true,
      "remove": true
    },
    "methodSalting": {
      "enabled": true
    },
    "classSalting": {
      "enabled": true,
      "unifyAccess": true
    },
    "fixConstants": {
      "enabled": true
    },
    "integerEncrypt": {
      "enabled": true,
      "excludeLowSignificant": false
    },
    "encryptStrings": {
      "enabled": true,
      "translateConcat": true,
      "minLength": 1
    },
    "flowInts": {
      "enabled": true,
      "obfuscateLongs": true,
      "separateBlocks": true,
      "confuseFlow": true
    },
    "controlFlowFlatten": {
      "enabled": true,
      "useSalt": true
    },
    "controlFlowShuffle": {
      "enabled": false
    },
    "cleanDeadCode": {
      "enabled": true
    },
    "referenceObfuscate": {
      "enabled": false
    }
  }
}
